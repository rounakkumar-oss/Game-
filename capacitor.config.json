{
  "appId": "com.aistudio.cosmicpop.vqxrmp",
  "appName": "Cosmic Pop 3D",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#00000000"
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#3B2268"
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  }
}
